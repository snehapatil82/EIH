# ─── Backend Environment Variables (set these in Render Dashboard) ───
DATABASE_URL=sqlite+aiosqlite:///./eih_data.db
SYNC_DATABASE_URL=sqlite:///./eih_data.db
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_PROVIDER=local
MAX_AGENT_RETRIES=3
SANDBOX_TIMEOUT_SECONDS=30
ALLOW_SUBPROCESS_TESTS=true
GITHUB_TOKEN=
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://eih-frontend.onrender.com
PORT=8000
